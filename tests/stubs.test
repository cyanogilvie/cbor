source [file join [file dirname [info script]] common.tcl]; runtests {

testConstraint haveJitc	[expr {![catch {package require jitc 0.8}]}]

# The commands in stubs_api.c exercise the C API from a separately compiled
# consumer: ::cbor_direct::* are compiled by jitc and linked directly against
# the package library (jitc's "package" part, driven by cbor::pkgconfig), and
# ::cbor_stubs::* are in a meson-built extension that goes through the stubs
# table (libcborstub.a).  jitc can't link static libraries, so it can't test
# the stubs path itself.
variable direct_cdef	[list \
	options			{-Wall -Werror} \
	package			[list cbor [package require cbor]] \
	include_path	[file dirname [file normalize [info script]]] \
	code {
		#include "stubs_api.c"

		INIT { return stubs_api_register(interp, "::cbor_direct"); }
		RELEASE { Tcl_Namespace* ns = Tcl_FindNamespace(interp, "::cbor_direct", NULL, 0); if (ns) Tcl_DeleteNamespace(ns); }
		OBJCMD(compile) { return TCL_OK; }
	} \
]
if {[testConstraint haveJitc]} {
	jitc::capply $direct_cdef compile
}

set consumer	[file join [file dirname [cbor::pkgconfig get libdir,runtime]] libcborstubsconsumer[info sharedlibextension]]
testConstraint haveStubsConsumer	[file exists $consumer]
if {[testConstraint haveStubsConsumer]} {
	load $consumer Cborstubsconsumer
}

# pkgconfig (TIP 59) {{{
test stubs-1.1 {pkgconfig keys} -body {
	lsort [cbor::pkgconfig list]
} -result {header includedir,runtime libdir,runtime library packagedir,runtime stublib}
test stubs-1.2 {pkgconfig header is present in includedir} -body {
	list \
		[file exists [file join [cbor::pkgconfig get includedir,runtime] [cbor::pkgconfig get header]]] \
		[file exists [file join [cbor::pkgconfig get includedir,runtime] cborDecls.h]]
} -result {1 1}
test stubs-1.3 {pkgconfig library and stublib are present in libdir} -body {
	set dir	[cbor::pkgconfig get libdir,runtime]
	list \
		[llength [glob -nocomplain -directory $dir lib[cbor::pkgconfig get library][info sharedlibextension]]] \
		[llength [glob -nocomplain -directory $dir lib[cbor::pkgconfig get stublib].a]]
} -cleanup {
	unset -nocomplain dir
} -result {1 1}
# }}}

foreach {mode n ns constraint} {
	direct	2	::cbor_direct	haveJitc
	stubs	3	::cbor_stubs	haveStubsConsumer
} {

	test stubs-$n.1 "$mode: CBOR_ReadHead" -constraints $constraint -body {
		# {"a": 1000, "b": -300, "c": [_ NaN, 100000.0, 1.1], "d": 1((_ h'00', h''))}
		${ns}::heads [binary decode hex [join {
			a4
			6161 1903e8
			6162 39012b
			6163 9f f97e00 fa47c35000 fb3ff199999999999a ff
			6164 c1 5f 4100 40 ff
		} ""]]
	} -result {5:4 3:1 0:1000 3:1 1:299 3:1 4:0:indef 7:32256:nan 7:1203982336:100000 7:4607632778762754458:1.1 7:0:break 3:1 6:1 2:0:indef 2:1 2:0 7:0:break}

	test stubs-$n.2 "$mode: CBOR_ReadHead errors" -constraints $constraint -body {
		list \
			[catch {${ns}::heads [binary decode hex 19]} r o] $r [dict get $o -errorcode] \
			[catch {${ns}::heads [binary decode hex 1c]} r o] $r [dict get $o -errorcode] \
			[catch {${ns}::heads [binary decode hex 1f]} r o] [dict get $o -errorcode] \
			[catch {${ns}::heads [binary decode hex f810]} r o] [dict get $o -errorcode]
	} -cleanup {
		unset -nocomplain r o
	} -result {1 {CBOR value truncated} {CBOR TRUNCATED} 1 {CBOR syntax error: reserved additional info value: 28} {CBOR INVALID} 1 {CBOR INVALID} 1 {CBOR INVALID}}

	test stubs-$n.3 "$mode: encoder API" -constraints $constraint -body {
		regsub -all -line { +$} [cbor pretty [${ns}::build 18446744073709551616]] {}
	} -result {{
  "i": -500,
  "f": 1.5_1,
  "b": h'00ff',
  "t": 1(1e+09_2),
  "a": [_
    true,
    null,
    undefined,
    simple(32),
    1
  ],
  "n": 2(h'010000000000000000'),
  "x": null
}}

	test stubs-$n.4 "$mode: CBOR_Get with tags" -constraints $constraint -body {
		set doc	[cbor template {{"a": [1, {"~tag": 1, "~val": {"~tag": 55799, "~val": 1.5}}]}}]
		list \
			[${ns}::tget $doc {a 1}] \
			[${ns}::tget $doc {a 0}] \
			[catch {${ns}::tget $doc {a 2}} r o] $r [dict get $o -errorcode]
	} -cleanup {
		unset -nocomplain doc r o
	} -result {{1.5 {1 55799}} {1 {}} 1 {path not found} {CBOR NOTFOUND {a 2}}}

	test stubs-$n.5 "$mode: CBOR_Extract" -constraints $constraint -body {
		binary encode hex [${ns}::extract [cbor template {{"a": ["x", {"b": true}]}}] {a 1}]
	} -result a16162f5

	test stubs-$n.6 "$mode: CBOR_DecodeValue and CBOR_Length over a sequence" -constraints $constraint -body {
		${ns}::decodeall [binary decode hex [join {
			1864
			c074323031332d30332d32315432303a30343a30305a
			8201820203
		} ""]]
	} -result {2 100 {} 22 2013-03-21T20:04:00Z 0 5 {1 {2 3}} {}}

	test stubs-$n.7 "$mode: CBOR_Template" -constraints $constraint -body {
		cbor pretty [${ns}::tmpl {{"k": "~S:s", "n": "~N:n", "b": "~BY:b"}} {s hello n -1 b "\x01"}]
	} -result {{
  "k": "hello",
  "n": -1,
  "b": h'01'
}}

	test stubs-$n.8 "$mode: CBOR_WellFormed and CBOR_Pretty" -constraints $constraint -body {
		list \
			[${ns}::pretty [binary decode hex 83010203]] \
			[catch {${ns}::pretty [binary decode hex 8301020304]} r o] [dict get $o -errorcode]
	} -cleanup {
		unset -nocomplain r o
	} -result {{[
  1,
  2,
  3
]} 1 {CBOR TRAILING}}

	test stubs-$n.9 "$mode: CBOR_ApplyTag" -constraints $constraint -body {
		list \
			[${ns}::apply_tag 2 [binary decode hex 010000000000000000]] \
			[${ns}::apply_tag 3 [binary decode hex 010000000000000000]] \
			[catch {${ns}::apply_tag 4 x} r] $r
	} -cleanup {
		unset -nocomplain r
	} -result {18446744073709551616 -18446744073709551617 1 {Tag 4 not supported}}
}
unset -nocomplain mode n ns constraint consumer

}

# vim: ft=tcl foldmethod=marker foldmarker={{{,}}} ts=4 shiftwidth=4 noexpandtab
